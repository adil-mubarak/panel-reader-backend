# External panel-segmentation worker used by the Go backend.
PANEL_READER_AI_URL=http://127.0.0.1:8090
PANEL_READER_AI_STORAGE_ROOT=/data
PANEL_READER_AI_TIMEOUT=30s
# Overall extraction, rendering, detection, and publishing deadline per comic.
PANEL_READER_IMPORT_TIMEOUT=2h

# AI service configuration used by compose.yaml. The default hosted provider
# needs your own Roboflow key in .env; never commit that secret. To use the
# checkpoint in models/comic-panel-seg.pt instead, run compose.local.yaml (or
# make ai-local), which always forces PANEL_AI_PROVIDER=local.
PANEL_MODEL_VERSION=comic-panel-seg-v1
PANEL_CONFIDENCE=0.25
PANEL_IMAGE_SIZE=1280
PANEL_DEVICE=cpu
PANEL_AI_UID=1000
PANEL_AI_GID=1000

# Hosted Roboflow provider.
PANEL_AI_PROVIDER=roboflow_hybrid
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=comic-panel-detectors/7
ROBOFLOW_PANEL_CLASSES=panel,panels
ROBOFLOW_COMIC_MODEL_ID=comic-panel-detectors/7
ROBOFLOW_COMIC_PANEL_CLASSES=panel,panels
ROBOFLOW_MANGA_MODEL_ID=manga-test/2
ROBOFLOW_MANGA_PANEL_CLASSES=manga-panel
# Leave empty to use the comic model until a webtoon-specific model is selected.
ROBOFLOW_WEBTOON_MODEL_ID=
ROBOFLOW_WEBTOON_PANEL_CLASSES=panel,panels
ROBOFLOW_WORKSPACE=adil-mubarak
ROBOFLOW_WORKFLOW_ID=general-segmentation-api-12
ROBOFLOW_WORKFLOW_CLASSES=Cover, Panels
ROBOFLOW_COMIC_WORKFLOW_CLASSES=Cover, Panels
ROBOFLOW_MANGA_WORKFLOW_CLASSES=Panels
ROBOFLOW_WEBTOON_WORKFLOW_CLASSES=Panels
ROBOFLOW_MASK_MATCH_IOU=0.30
